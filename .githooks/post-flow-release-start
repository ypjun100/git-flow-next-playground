#!/bin/bash
#
# post-flow-release-start
#
# Hook that runs after a release branch is created.
# Arguments:
#   $1 - VERSION: the release version (e.g., v1.2.0)
#   $2 - BASE: the base branch (e.g., main)
#   $3 - BRANCH: the full release branch name (e.g., release/v1.2.0)
#
# Purpose: Update package.json version to match the release version.
#          The "v" prefix is stripped so package.json contains only the number (e.g., 1.2.0).

set -e

VERSION="$1"
BRANCH="${3:-release/${VERSION}}"
PACKAGE_JSON="package.json"

# Strip leading "v" for package.json (e.g., v1.2.0 → 1.2.0)
PACKAGE_VERSION="${VERSION#v}"

if [[ -z "$VERSION" ]]; then
  echo "Warning: VERSION argument not provided. Skipping package.json update."
  exit 0
fi

if [[ ! -f "$PACKAGE_JSON" ]]; then
  echo "Warning: $PACKAGE_JSON not found. Skipping version update."
  exit 0
fi

CURRENT_VERSION=$(grep '"version"' "$PACKAGE_JSON" | head -1 | sed 's/.*"version": *"\([^"]*\)".*/\1/')

if [[ "$CURRENT_VERSION" == "$PACKAGE_VERSION" ]]; then
  echo "package.json version is already $PACKAGE_VERSION. No update needed."
  exit 0
fi

echo "Updating package.json version: $CURRENT_VERSION → $PACKAGE_VERSION"

# Update version in package.json (macOS compatible)
sed -i '' "s/\"version\": \"[^\"]*\"/\"version\": \"$PACKAGE_VERSION\"/" "$PACKAGE_JSON"

# Commit the version bump
git add "$PACKAGE_JSON"
git commit -m "chore: bump version to $PACKAGE_VERSION"

echo "✓ package.json version updated to $PACKAGE_VERSION and committed."

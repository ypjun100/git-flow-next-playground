#!/bin/bash
#
# pre-flow-hotfix-start
#
# Prevents direct use of `git flow hotfix start`.
# Hotfix branches complicate version management — use a release branch instead.

echo ""
echo "Error: 'git flow hotfix start' is not allowed in this project."
echo ""
echo "Please create a release branch for the fix:"
echo "  git flow release start <version>"
echo ""
echo "Example:"
echo "  git flow release start v1.2.1"
echo ""
exit 1

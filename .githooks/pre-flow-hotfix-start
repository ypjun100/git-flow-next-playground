#!/bin/bash
#
# pre-flow-hotfix-start
#
# Hook that runs before a hotfix branch is created.
# Arguments:
#   $1 - VERSION: branch name without prefix (e.g., v1.2.1)
#   $2 - ORIGIN:  remote name (e.g., origin)
#   $3 - BRANCH:  full branch name (e.g., hotfix/v1.2.1)
#   $4 - BASE:    base branch (e.g., main)
#
# Purpose: Pull latest base branch before creating the hotfix branch
# so the hotfix always starts from an up-to-date state.

set -e

VERSION="$1"
BASE="${4:-main}"

echo "Pulling latest '$BASE' before creating hotfix/$VERSION..."

if git remote get-url origin &>/dev/null; then
  git fetch origin "${BASE}:${BASE}" --update-head-ok 2>/dev/null || {
    echo "Warning: Could not update '$BASE' from remote. Proceeding with local state."
  }
  echo "✓ '$BASE' is up to date."
else
  echo "Warning: No remote 'origin' found. Skipping pull."
fi

#!/bin/bash
#
# post-flow-release-finish
#
# Hook that runs after a release branch is finished by git-flow.
# Arguments:
#   $1 - VERSION: the release version (e.g., v1.2.0)
#   $2 - ORIGIN:  remote name (e.g., origin)
#   $3 - BRANCH:  full branch name (e.g., release/v1.2.0)
#
# Purpose: Push main + tag to origin, then create a GitHub Release with
#          commit messages since the previous tag as release notes.

VERSION="$1"
TAG="${VERSION}"

if ! git remote get-url origin &>/dev/null; then
  echo "No remote 'origin' found. Skipping push."
  exit 0
fi

# ── Push main and tag ────────────────────────────────────────────────────────
echo "Pushing main and tag $TAG to origin..."
git push origin main
git push origin "$TAG"
echo "✓ main and tag $TAG pushed to origin."

# ── Create GitHub Release ────────────────────────────────────────────────────
if ! command -v gh &>/dev/null; then
  echo "Note: 'gh' CLI not found. Skipping GitHub Release creation."
  exit 0
fi

if gh release view "$TAG" &>/dev/null 2>&1; then
  echo "Note: GitHub Release $TAG already exists — skipping."
  exit 0
fi

# Resolve GitHub repo URL for commit hyperlinks
_get_repo_url() {
  local url
  url=$(git remote get-url origin 2>/dev/null || echo "")
  url="${url/git@github.com:/https://github.com/}"
  url="${url%.git}"
  echo "$url"
}

REPO_URL=$(_get_repo_url)

# Build release notes: commits between the previous tag and this tag
PREV_TAG=$(git tag --sort=-version:refname | grep -v "^${TAG}$" | head -1 2>/dev/null || echo "")

if [[ -n "$PREV_TAG" ]]; then
  LOG_RANGE="${PREV_TAG}..${TAG}"
else
  LOG_RANGE="${TAG}"
fi

RELEASE_NOTES=""
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  sha="${line%% *}"; msg="${line#* }"
  if [[ -n "$REPO_URL" ]]; then
    RELEASE_NOTES+="- [${msg}](${REPO_URL}/commit/${sha})"$'\n'
  else
    RELEASE_NOTES+="- ${msg}"$'\n'
  fi
done < <(git log "$LOG_RANGE" --pretty=format:"%H %s" --no-merges 2>/dev/null | head -30)
RELEASE_NOTES="${RELEASE_NOTES%$'\n'}"

gh release create "$TAG" \
  --title "$TAG" \
  --notes "## Changes
${RELEASE_NOTES:-No release notes available.}" \
  && echo "✓ GitHub Release $TAG created." \
  || echo "Warning: Failed to create GitHub Release $TAG."
